// Inkling – Custom Fairy Reading Tracker (Mobile-Friendly + Animated Sparkles, Vines, Butterflies, Sound)
// Technologies: React + Tailwind + Framer Motion (for soft, pretty aesthetic)

import { useState, useEffect } from 'react';
import { Card, CardContent } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Progress } from '@/components/ui/progress';
import { PieChart, Pie, Cell, Legend, Tooltip, BarChart, Bar, XAxis, YAxis, ResponsiveContainer } from 'recharts';
import { motion } from 'framer-motion';

const COLORS = ['#f7c5cc', '#ffd700', '#a8e6cf']; // pink, gold, green

const starterBooks = [
  {
    title: 'A Court of Thorns and Roses',
    genre: 'Fantasy',
    author: 'Sarah J. Maas',
    rating: 5,
    status: 'Completed',
    year: 2025,
    month: 'July',
    notes: 'A beautiful enemies-to-lovers arc with rich worldbuilding.',
  },
];

export default function InklingApp() {
  const [books, setBooks] = useState(starterBooks);
  const [newBook, setNewBook] = useState({
    title: '',
    genre: '',
    author: '',
    rating: '',
    status: 'Completed',
    year: 2025,
    month: 'July',
    notes: '',
  });
  const [avatarUrl, setAvatarUrl] = useState('');
  const [messages, setMessages] = useState(["Welcome to your enchanted library ✨"]);

  const genres = ['Fantasy', 'Romance', 'Thriller'];
  const genreCounts = genres.map((g) => ({
    name: g,
    value: books.filter((b) => b.genre === g).length,
  }));

  const completed = books.filter((b) => b.status === 'Completed').length;
  const readerType =
    genreCounts.find((g) => g.value === Math.max(...genreCounts.map((x) => x.value)))?.name ||
    'Inkling';

  const readerTypeLabel = {
    Fantasy: 'Dragonbound Reader 🐉',
    Romance: 'Heart-Seeker Reader 💋',
    Thriller: 'Sleuthcore Reader 🔮',
    Inkling: 'Inkling Reader ✨',
  }[readerType];

  const addBook = () => {
    setBooks([...books, newBook]);
    setNewBook({ title: '', genre: '', author: '', rating: '', status: 'Completed', year: 2025, month: 'July', notes: '' });
    new Audio('/fairy-chime.mp3').play();
    const newMessage = fairyMessages[Math.floor(Math.random() * fairyMessages.length)];
    setMessages((prev) => [...prev, newMessage]);
  };

  const authorCounts = books.reduce((acc, book) => {
    acc[book.author] = (acc[book.author] || 0) + 1;
    return acc;
  }, {});
  const sortedAuthors = Object.entries(authorCounts)
    .sort((a, b) => b[1] - a[1])
    .map(([name, count]) => ({ name, count }));

  const currentMonth = 'July';
  const booksThisMonth = books.filter((b) => b.month === currentMonth);

  const bookSuggestions = {
    Fantasy: 'Try "Fourth Wing" or "The Priory of the Orange Tree" 🐉',
    Romance: 'You might love "The Love Hypothesis" 💘',
    Thriller: 'Pick up "The Silent Patient" 🧠',
  };

  const fairyMessages = [
    "The petals whisper: You're doing amazing 🌸",
    "Your bookshelf just grew a tiny wing 🧚🏾‍♀️",
    "Another page, another spell cast 📖✨",
    "You are made of stories and stardust 💫",
    "A fairy just bookmarked your heart 💌",
  ];

  return (
    <motion.div className="p-4 bg-pink-50 min-h-screen text-center relative overflow-hidden" initial={{ opacity: 0 }} animate={{ opacity: 1 }} transition={{ duration: 0.8 }}>
      {/* 🌸 Floating sparkles & vines */}
      <motion.div className="absolute inset-0 z-0" initial={{ opacity: 0 }} animate={{ opacity: 1 }} transition={{ duration: 2 }}>
        <div className="absolute top-0 left-0 w-full h-full bg-[url('/sparkles.svg')] bg-repeat opacity-10 animate-pulse"></div>
        <div className="absolute top-0 left-0 w-full h-full bg-[url('/vines-and-flowers.svg')] bg-cover bg-no-repeat opacity-10"></div>
        <div className="absolute top-0 left-0 w-full h-full bg-[url('/butterflies.svg')] bg-repeat opacity-10 animate-float"></div>
      </motion.div>

      <div className="relative z-10 max-w-4xl mx-auto">
        <h1 className="text-3xl font-bold text-pink-600 mb-2">🧚🏾‍♀️ Inkling</h1>
        <p className="text-green-700 italic mb-6">A fairy-coded tracker for magical book girls</p>

        {avatarUrl && (
          <motion.img
            src={avatarUrl}
            alt="Your Avatar"
            className="mx-auto rounded-full w-24 h-24 object-cover border-4 border-gold-400 mb-4"
            initial={{ scale: 0.8, opacity: 0 }}
            animate={{ scale: 1, opacity: 1 }}
            transition={{ duration: 0.5 }}
          />
        )}
        <Input
          type="url"
          placeholder="Upload your avatar image URL"
          value={avatarUrl}
          onChange={(e) => setAvatarUrl(e.target.value)}
          className="mb-6 w-full max-w-xs mx-auto"
        />

        <div className="mb-4">
          {messages.slice(-3).map((msg, idx) => (
            <p key={idx} className="text-sm text-pink-500 italic">{msg}</p>
          ))}
        </div>

        <div className="grid gap-6 sm:grid-cols-1 md:grid-cols-2">
          <Card>
            <CardContent className="p-4">
              <h2 className="text-xl font-semibold mb-2">Add a Book</h2>
              <Input placeholder="Title" value={newBook.title} onChange={(e) => setNewBook({ ...newBook, title: e.target.value })} className="mb-2" />
              <Input placeholder="Genre" value={newBook.genre} onChange={(e) => setNewBook({ ...newBook, genre: e.target.value })} className="mb-2" />
              <Input placeholder="Author" value={newBook.author} onChange={(e) => setNewBook({ ...newBook, author: e.target.value })} className="mb-2" />
              <Input placeholder="Star Rating (1-5)" value={newBook.rating} onChange={(e) => setNewBook({ ...newBook, rating: e.target.value })} className="mb-2" />
              <Input placeholder="Fairy Notes or Thoughts" value={newBook.notes} onChange={(e) => setNewBook({ ...newBook, notes: e.target.value })} className="mb-2" />
              <Button onClick={addBook} className="bg-pink-400 hover:bg-pink-500 text-white">Add Book</Button>
            </CardContent>
          </Card>

          <Card>
            <CardContent className="p-4">
              <h2 className="text-xl font-semibold mb-2">📚 Yearly Progress</h2>
              <p className="mb-2">{completed} / 12 books read</p>
              <Progress value={(completed / 12) * 100} className="bg-pink-100" />
            </CardContent>
          </Card>

          <Card className="col-span-2">
            <CardContent className="p-4">
              <h2 className="text-xl font-semibold mb-4">📊 Genre Breakdown</h2>
              <ResponsiveContainer width="100%" height={250}>
                <PieChart>
                  <Pie data={genreCounts} dataKey="value" nameKey="name" cx="50%" cy="50%" outerRadius={60} fill="#8884d8" label>
                    {genreCounts.map((entry, index) => (
                      <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
                    ))}
                  </Pie>
                  <Tooltip />
                  <Legend />
                </PieChart>
              </ResponsiveContainer>
              <p className="mt-4 text-green-700">You are a <strong>{readerTypeLabel}</strong></p>
              <p className="text-sm mt-2 text-pink-600 italic">{bookSuggestions[readerType]}</p>
            </CardContent>
          </Card>

          <Card className="col-span-2">
            <CardContent className="p-4">
              <h2 className="text-xl font-semibold mb-4">📖 Most Read Authors</h2>
              <ResponsiveContainer width="100%" height={250}>
                <BarChart data={sortedAuthors}>
                  <XAxis dataKey="name" />
                  <YAxis />
                  <Tooltip />
                  <Bar dataKey="count" fill="#f7c5cc" />
                </BarChart>
              </ResponsiveContainer>
            </CardContent>
          </Card>

          <Card className="col-span-2">
            <CardContent className="p-4">
              <h2 className="text-xl font-semibold mb-2">🪻 Monthly Recap – {currentMonth}</h2>
              <p className="text-pink-700 mb-2">You read <strong>{booksThisMonth.length}</strong> book(s) this month!</p>
              <ul className="text-left text-sm text-green-900 list-disc ml-6">
                {booksThisMonth.map((book, idx) => (
                  <li key={idx}>
                    {book.title} by {book.author} – {book.rating}⭐ <br />
                    <em>Fairy Notes:</em> {book.notes}
                  </li>
                ))}
              </ul>
            </CardContent>
          </Card>
        </div>
      </div>
    </motion.div>
  );
}
